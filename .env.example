# ─── Copy this file to .env and fill in your values ──────────────
# cp .env.example .env

# ─── VPS Server ───────────────────────────────────────────────────
# IP address of your VPS (used in CORS + nginx config)
SERVER_IP=YOUR_VPS_IP_HERE

# ─── MySQL ────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=ganti_ini_root_password
MYSQL_USER=iot
MYSQL_PASSWORD=ganti_ini_iot_password

# ─── JWT ─────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=ganti_ini_minimal_32_karakter_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Weather (Open-Meteo, default Bandar Lampung) ─────────────────
WEATHER_CITY=Bandar Lampung
WEATHER_LAT=-5.3971
WEATHER_LON=105.2668

# ─── MQTT Broker ────────────────────────────────────────────────
MQTT_BROKER_URL=mqtt://YOUR_MQTT_HOST:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=energy/buildings

# ─── Notifikasi Telegram (opsional) ────────────────────────────────
# Kosongkan untuk menonaktifkan. Token dari @BotFather, chat ID dari
# https://api.telegram.org/bot<TOKEN>/getUpdates setelah kirim pesan ke bot/grup.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
