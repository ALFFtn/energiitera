# Frontend Configuration for GridMonitor
# Copy this file to .env.local and update values

# API Configuration
# Set this to your backend API URL
# Examples:
#   - Local development: http://localhost:3001
#   - Vercel/Production: https://api.yourdomain.com
#   - Same domain reverse proxy: https://yourdomain.com
VITE_API_URL=http://localhost:3001

# Socket.io Configuration (optional, defaults to VITE_API_URL)
# VITE_SOCKET_URL=http://localhost:3001

# Environment
VITE_ENV=development
