# Database
DATABASE_URL=mysql://REDACTED:REDACTED@REDACTED-HOST-1:3306/REDACTED
# JWT
JWT_SECRET=dev-secret-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Server
PORT=3001
NODE_ENV=development

# CORS
CORS_ORIGIN=http://localhost:5173

# MQTT Broker
MQTT_BROKER_URL=mqtt://iterahero.com:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=energy/buildings

# Worker Settings
BATCH_WRITE_INTERVAL_MS=5000
BATCH_SIZE=100
