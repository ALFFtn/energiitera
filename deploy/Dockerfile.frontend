# ─── Stage 1: Build Vite/React ────────────────────────────────────
FROM mirror.gcr.io/library/node:20-alpine AS builder
WORKDIR /build

COPY apps/grid-monitor/package.json ./
RUN npm install

COPY apps/grid-monitor/ ./

# VITE_API_URL is intentionally empty so the frontend uses same-origin
# requests routed by nginx (/api/ → api:3001, /socket.io/ → api:3001)
ARG VITE_API_URL=""
ENV VITE_API_URL=$VITE_API_URL

RUN npm run build

# ─── Stage 2: Nginx serving ───────────────────────────────────────
FROM mirror.gcr.io/library/nginx:alpine AS runner
COPY --from=builder /build/dist /usr/share/nginx/html
COPY deploy/nginx/default.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
